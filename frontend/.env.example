# URL da API NestJS
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Produção registra a PWA automaticamente. Ative em dev apenas para testes locais.
NEXT_PUBLIC_ENABLE_PWA="false"

# Firebase Client SDK Configuration
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyMockKeyForDevelopmentOnly"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="mercadolajinha.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="mercadolajinha"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="mercadolajinha.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef123"

# ImageKit Public Key e URL Endpoint
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="your_imagekit_public_key"
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_id"

# Chave pública Web Push do projeto Firebase (necessária em serviços como Chrome Push)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
