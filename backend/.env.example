# Neon PostgreSQL connection string (Pooling / PgBouncer)
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Neon Direct connection string (Direct for migrations)
DIRECT_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Server Port
NODE_ENV="development"
PORT=3001

# Frontend URL (CORS and WebSockets)
FRONTEND_URL="http://localhost:3000"
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key\n-----END PRIVATE KEY-----\n"

# Somente para desenvolvimento local sem Firebase. Nunca habilite em produção.
ALLOW_INSECURE_DEV_AUTH=false

# ImageKit Configuration
IMAGEKIT_PUBLIC_KEY="your_public_key"
IMAGEKIT_PRIVATE_KEY="your_private_key"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_id"
